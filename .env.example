# ==========================================================================
#  Imtiyaz El Djazair — environment variables
#  Copy this file to `.env` and fill in REAL values. Never commit `.env`.
# ==========================================================================

# --- Database (REQUIRED) --------------------------------------------------
# PostgreSQL. Both variables are required — Prisma errors at startup if either
# is missing, and neither has a usable default, so paste your own values here.
#
# Where to get a free one:
#   Neon              https://neon.tech            (works well on Vercel)
#   Supabase          https://supabase.com/database
#   Vercel Postgres   Vercel dashboard -> Storage -> Create Database
#   Or your own:      postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
#
# DATABASE_URL is what the app queries through. On a host that pools connections
# (Neon, Supabase, PgBouncer) use the POOLED string here — a serverless function
# opens a connection per invocation and will exhaust a direct one.
DATABASE_URL=""
#
# DIRECT_URL is used only to change the schema (`prisma db push`/`migrate`),
# which cannot run over a transaction-mode pooler. Use the DIRECT/non-pooled
# string. With a plain Postgres and no pooler, set it to the same value.
DIRECT_URL=""
#
# SQLite is no longer supported. It cannot work on a serverless host: the
# filesystem is read-only and each invocation gets its own copy, so writes are
# lost and no two requests see the same data.

# --- Site -----------------------------------------------------------------
# Public base URL. Used for sitemap.xml, robots.txt, canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Security -------------------------------------------------------------
# 32+ random characters. Generate with:  openssl rand -base64 48
# Signs session and CSRF tokens.
#
# RECOMMENDED but no longer fatal if unset: when it is missing the app
# generates a 64-byte key once and stores it in the database, so a deployment
# without this variable can still be signed into. Setting it here is stronger —
# the key then lives only in the environment, so a database leak alone cannot
# be used to forge a session.
AUTH_SECRET="change-me-please-generate-a-long-random-string"

# --- Initial Super Admin --------------------------------------------------
# Used ONLY by `npm run db:seed` to create the very first owner account.
# The password is hashed (scrypt) before it is stored; it is never persisted
# in clear text, never sent to the browser and never written to logs.
# Delete/blank ADMIN_PASSWORD after the first successful login.
ADMIN_EMAIL="owner@imtiyazeldjazair.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Site Owner"

# --- Uploads --------------------------------------------------------------
# Max upload size in megabytes for the Media Library.
MAX_UPLOAD_MB="8"

# --- AI Assistant (optional) ----------------------------------------------
# Powers Admin -> AI Assistant: improve, translate, correct and summarise the
# site's text. Leave it blank and the rest of the dashboard works unchanged —
# the assistant page simply says it is not connected.
#
# Get a key at https://console.anthropic.com/settings/keys
# It is read ONLY on the server (src/lib/ai.ts is `server-only`) and is never
# sent to the browser. Do NOT prefix it with NEXT_PUBLIC_.
#
# Optional here: a Super Admin can also paste the key straight into
# Admin -> AI Assistant, which stores it in the database. This variable wins
# when both are set, and is the better place for it.
ANTHROPIC_API_KEY=""

# --- Advanced -------------------------------------------------------------
# Allows the Super Admin to inject custom <script> tags from Admin -> Advanced.
# Keep "false" unless you really need it: custom JS can introduce XSS.
ALLOW_CUSTOM_SCRIPTS="false"

# Set to "true" to seed demo content (services, posts, testimonials...).
SEED_DEMO_CONTENT="true"
