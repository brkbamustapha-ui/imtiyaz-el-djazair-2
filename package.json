{
  "name": "imtiyaz-el-djazair",
  "version": "1.0.0",
  "private": true,
  "description": "Imtiyaz El Djazair — School & Exam Center. Public website + headless CMS + admin dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "build:cpanel": "node scripts/build-cpanel.mjs",
    "start:cpanel": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:migrate": "prisma migrate dev",
    "db:baseline": "prisma migrate resolve --applied 20260827000000_init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "^9.3.0",
    "framer-motion": "^13.1.1",
    "next": "^15.5.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.24",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
